ANTHROPIC_API_KEY=your_api_key_here

# Supabase (Project Settings -> API in the dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role secret key -- NOT the anon/publishable key. RLS is enabled
# with no policies on variants/fetch_snapshots/structured_offers, so the
# anon key cannot write to them; these scripts need service_role to bypass
# RLS. Never expose this key client-side.
SUPABASE_KEY=your_service_role_key_here

# ScraperAPI (scraperapi.com) -- routes fetch_offers.py's requests through
# ScraperAPI's proxy layer instead of hitting Flipkart/Amazon directly.
# Optional: if unset, fetch_offers.py falls back to a direct request.
# Added after Flipkart started returning HTTP 403s at volume and Amazon
# India was found to hard-block plain scraping on the first request.
SCRAPERAPI_KEY=your_scraperapi_key_here

# Gmail SMTP -- sends one summary email per pipeline run for any alerts
# that fired (see notify.py). Optional: if unset, notify.py is a no-op,
# alerts are still recorded and shown on the dashboard as before.
# GMAIL_APP_PASSWORD must be a Gmail "App Password" (myaccount.google.com
# /apppasswords, requires 2-Step Verification), NOT the real account
# password -- Gmail blocks plain password SMTP auth for security.
GMAIL_ADDRESS=your_gmail_address_here
GMAIL_APP_PASSWORD=your_16_char_app_password_here
# Defaults to GMAIL_ADDRESS if unset -- set this only if alerts should go
# to a different inbox than the sending account.
GMAIL_TO=
